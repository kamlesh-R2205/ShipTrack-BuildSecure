# ==============================================================================
# SHIPTRACK GUARD — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and provide your deployment-specific configuration.
# NEVER commit your actual .env file or production secrets to Git.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB local or MongoDB Atlas)
# Either MONGODB_URI or MONGO_URI is supported
MONGODB_URI=mongodb://127.0.0.1:27017/shiptrack
MONGO_URI=mongodb://127.0.0.1:27017/shiptrack

# Cryptographic Authentication Security
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=24h

# Allowed Client Origin (Cross-Origin Resource Sharing - CORS)
# In development: http://localhost:5173
# In production: https://shiptrack-guard.vercel.app
CLIENT_URL=http://localhost:5173

# Frontend API Endpoint (Vite Client Build Variable)
# In local development: /api (proxied via Vite) or http://localhost:5000/api
# In production: https://shiptrack-guard-backend.onrender.com/api
VITE_API_URL=/api
